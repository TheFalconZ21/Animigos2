{
  "rewrites": [
    {
      "source": "/media/:match*",
      "destination": "https://api.animigos.app/media/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://api.animigos.app/api/:match*"
    },
    {
      "source": "/((?!assets/|api/|media/).*)",
      "destination": "/index.html"
    }
  ]
}

